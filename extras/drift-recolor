#!/bin/bash
# drift-recolor — recolour the Drift theme from the wallpaper on screen.
#
#   drift-recolor            use the current background
#   drift-recolor <image>    use a specific image
#   drift-recolor --force    recolour even if this image was already used
#   drift-recolor --reset    go back to the default graphite palette
#
# Aether extracts the palette (--no-apply, so Aether changes nothing itself);
# this writes it to the theme's colors.toml, renders shell.toml from
# extras/shell.toml.tpl, and re-applies Drift without touching the wallpaper.
# Does nothing unless Drift is the active theme.
set -euo pipefail

THEME_DIR="$HOME/.config/omarchy/themes/drift"
STATE="$HOME/.local/state/omarchy"
LAST="$STATE/drift-recolor.last"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/drift-recolor.lock"

force=0 reset=0 image=""
for arg in "$@"; do
  case $arg in
    --force) force=1 ;;
    --reset) reset=1 ;;
    *) image=$arg ;;
  esac
done

exec 9>"$LOCK"
flock 9

[[ $(cat "$STATE/current/theme.name" 2>/dev/null) == "drift" ]] || exit 0

apply() {
  OMARCHY_THEME_SKIP_BACKGROUND=1 omarchy-theme-set drift </dev/null >/dev/null
}

# False once another theme is active or a switch is under way (omarchy-theme-set
# holds next-theme until it swaps). Applying then would undo the user's switch.
drift_active() {
  [[ $(cat "$STATE/current/theme.name" 2>/dev/null) == "drift" && ! -e $STATE/current/next-theme ]]
}

on_screen() { readlink -f "$STATE/current/background" 2>/dev/null || true; }

# $LAST holds the wallpaper on screen when the palette was chosen, not the
# palette's source. Applying fires the path unit, which must then find nothing
# to do, or it would replace a --reset or explicit-image palette straight away.
if (( reset )); then
  git -C "$THEME_DIR" show HEAD:colors.toml >"$THEME_DIR/colors.toml"
  git -C "$THEME_DIR" show HEAD:shell.toml >"$THEME_DIR/shell.toml"
  on_screen >"$LAST"
  apply
  echo "Drift reset to its default palette"
  exit 0
fi

command -v aether >/dev/null || { echo "aether is not installed (omarchy pkg aur add aether)" >&2; exit 1; }

# Aether's accent is always its blue slot. Print the palette colour nearest the
# wallpaper's dominant hue instead, or nothing to keep Aether's choice (no
# ImageMagick, a near-greyscale image, or no close and readable colour).
pick_accent() {
  command -v magick >/dev/null || return 0
  magick "$1[0]" -resize '64x36!' -depth 8 rgb:- 2>/dev/null | od -An -vtu1 -w3 |
    awk -v palette="$(omarchy-theme-color --file "$2" --all)" '
    function hex(s) { s = tolower(s); return (index(H, substr(s, 1, 1)) - 1) * 16 + index(H, substr(s, 2, 1)) - 1 }
    function hue(r, g, b,   mx, mn) {
      mx = r; if (g > mx) mx = g; if (b > mx) mx = b
      mn = r; if (g < mn) mn = g; if (b < mn) mn = b
      CHROMA = (mx - mn) / 255
      if (mx == mn) { HUE = 0; return }
      if (mx == r) HUE = 60 * (g - b) / (mx - mn)
      else if (mx == g) HUE = 120 + 60 * (b - r) / (mx - mn)
      else HUE = 240 + 60 * (r - g) / (mx - mn)
      if (HUE < 0) HUE += 360
    }
    function lin(v) { v /= 255; return v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ^ 2.4 }
    function lum(c) { return 0.2126 * lin(hex(substr(c, 2, 2))) + 0.7152 * lin(hex(substr(c, 4, 2))) + 0.0722 * lin(hex(substr(c, 6, 2))) }
    BEGIN {
      H = "0123456789abcdef"
      n = split(palette, lines, "\n")
      for (i = 1; i <= n; i++) { split(lines[i], kv, "\t"); p[kv[1]] = kv[2] }
    }
    {
      hue($1, $2, $3)
      if (CHROMA >= 0.12) { bins[int(HUE / 10) % 36] += CHROMA; total += CHROMA }
    }
    END {
      if (!total) exit
      for (i = 0; i < 36; i++) {
        s = bins[(i + 35) % 36] + bins[i] + bins[(i + 1) % 36]
        if (s > best) { best = s; dominant = i * 10 + 5 }
      }
      bg = lum(p["background"])
      n = split("red orange yellow green cyan blue magenta", keys, " ")
      for (i = 1; i <= n; i++) {
        c = p[keys[i]]
        if (length(c) != 7) continue
        hue(hex(substr(c, 2, 2)), hex(substr(c, 4, 2)), hex(substr(c, 6, 2)))
        l = lum(c)
        contrast = l > bg ? (l + 0.05) / (bg + 0.05) : (bg + 0.05) / (l + 0.05)
        if (CHROMA < 0.2 || contrast < 3) continue
        d = HUE - dominant; if (d < 0) d = -d; if (d > 180) d = 360 - d
        if (pick == "" || d < gap) { pick = c; gap = d }
      }
      if (pick != "" && gap <= 40) print pick
    }'
}

recolor() {
  local image=$1 tmp out accent
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"; trap - RETURN' RETURN

  out=$(aether --generate "$image" --no-apply --output "$tmp" --no-zed --no-vscode --no-neovim 2>&1) || {
    echo "$out" >&2
    return 1
  }
  [[ -s $tmp/colors.toml ]] || { echo "Aether produced no palette for $image" >&2; return 1; }

  accent=$(pick_accent "$image" "$tmp/colors.toml" || true)
  [[ -z $accent ]] || sed -i "s/^accent = .*/accent = \"$accent\"/" "$tmp/colors.toml"

  # Resolve Aether's names (bg, dark_fg, ...) to Omarchy's canonical keys.
  declare -A c
  while IFS=$'\t' read -r key value; do
    c[$key]=$value
  done < <(omarchy-theme-color --file "$tmp/colors.toml" --all)

  shell=$(<"$THEME_DIR/extras/shell.toml.tpl")
  for key in "${!c[@]}"; do
    shell=${shell//"{{$key}}"/${c[$key]}}
  done
  if [[ $shell =~ \{\{([a-z_]+)\}\} ]]; then
    echo "Palette is missing '${BASH_REMATCH[1]}', keeping current colours" >&2
    return 1
  fi

  drift_active || return 0

  {
    echo "# Generated by drift-recolor from ${image##*/}"
    cat "$tmp/colors.toml"
  } >"$THEME_DIR/colors.toml.new"
  printf '%s\n' "$shell" >"$THEME_DIR/shell.toml.new"
  mv "$THEME_DIR/colors.toml.new" "$THEME_DIR/colors.toml"
  mv "$THEME_DIR/shell.toml.new" "$THEME_DIR/shell.toml"

  mkdir -p "$STATE"
  printf '%s\n' "$seen" >"$LAST"
  apply
  echo "Drift recoloured from ${image##*/} (accent ${c[accent]})"
}

# Let a wallpaper switch settle, then recolour. Check again afterwards in case
# the wallpaper changed while we were busy.
[[ -n $image ]] || sleep 0.3
while :; do
  drift_active || exit 0
  seen=$(on_screen)
  target=$(readlink -f "${image:-$STATE/current/background}" 2>/dev/null || true)
  [[ -f $target ]] || { echo "No background image found" >&2; exit 1; }
  [[ ${target,,} =~ \.(jpe?g|png|webp|bmp|gif)$ ]] || { echo "Not an image, skipping: $target" >&2; exit 0; }
  if (( !force )) && [[ -z $image && $(cat "$LAST" 2>/dev/null) == "$target" ]]; then
    exit 0
  fi
  recolor "$target"
  force=0
  [[ -z $image ]] || exit 0
done
